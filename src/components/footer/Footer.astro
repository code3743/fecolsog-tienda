---
import { Icon } from "astro-icon/components";
---

<footer class="bg-base-300 text-base-content pt-16 pb-8 mt-auto" aria-label="Pie de página">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div
            class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12"
        >
            <!-- Brand Section -->
            <div class="col-span-1 lg:col-span-1">
                <a href="/" class="flex items-center gap-2 mb-6 group">
                    <div
                        class="w-10 h-10 bg-primary rounded-xl flex items-center justify-center group-hover:rotate-12 transition-transform shadow-lg"
                    >
                        <Icon
                            name="lucide:stethoscope"
                            class="w-6 h-6 text-primary-content"
                        />
                    </div>
                    <span
                        class="text-2xl font-bold tracking-tighter gradient-text"
                    >
                        FECOLSOG
                    </span>
                </a>
                <p class="text-base-content/70 mb-2 leading-relaxed text-sm">
                    Federación Colombiana de Obstetricia y Ginecología
                </p>
                <p class="text-base-content/60 mb-6 leading-relaxed text-sm">
                    Carrera 15 No 98-42, Bogotá — Colombia<br/>
                    Lun–Vie: 08:00 AM – 5:30 PM
                </p>
                <!-- Socials -->
                <div class="flex gap-4">
                    <a
                        href="https://www.facebook.com/FECOLSOG"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-circle btn-sm btn-ghost hover:bg-primary/20 hover:text-primary transition-colors"
                        aria-label="Facebook"
                    >
                        <Icon name="lucide:facebook" class="w-5 h-5" />
                    </a>
                    <a
                        href="https://www.instagram.com/fecolsog"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-circle btn-sm btn-ghost hover:bg-primary/20 hover:text-primary transition-colors"
                        aria-label="Instagram"
                    >
                        <Icon name="lucide:instagram" class="w-5 h-5" />
                    </a>
                    <a
                        href="https://twitter.com/fecolsog"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-circle btn-sm btn-ghost hover:bg-primary/20 hover:text-primary transition-colors"
                        aria-label="Twitter / X"
                    >
                        <Icon name="lucide:twitter" class="w-5 h-5" />
                    </a>
                </div>
            </div>

            <!-- Links Column 1 -->
            <div>
                <h3 class="font-bold text-lg mb-6 text-base-content/90">
                    Tienda
                </h3>
                <ul class="space-y-4">
                    <li>
                        <a
                            href="/category/indumentaria"
                            class="text-base-content/60 hover:text-primary hover:translate-x-1 transition-all inline-block"
                            >Indumentaria Médica</a
                        >
                    </li>
                    <li>
                        <a
                            href="/category/insumos"
                            class="text-base-content/60 hover:text-primary hover:translate-x-1 transition-all inline-block"
                            >Insumos Médicos</a
                        >
                    </li>
                    <li>
                        <a
                            href="/category/dispositivos"
                            class="text-base-content/60 hover:text-primary hover:translate-x-1 transition-all inline-block"
                            >Dispositivos</a
                        >
                    </li>
                    <li>
                        <a
                            href="/category/educacion"
                            class="text-base-content/60 hover:text-primary hover:translate-x-1 transition-all inline-block"
                            >Publicaciones</a
                        >
                    </li>
                    <li>
                        <a
                            href="/category/congresos"
                            class="text-base-content/60 hover:text-primary hover:translate-x-1 transition-all inline-block"
                            >Congresos y Eventos</a
                        >
                    </li>
                </ul>
            </div>

            <!-- Links Column 2 -->
            <div>
                <h3 class="font-bold text-lg mb-6 text-base-content/90">
                    Soporte
                </h3>
                <ul class="space-y-4">
                    <li>
                        <a
                            href="/contact"
                            class="text-base-content/60 hover:text-primary hover:translate-x-1 transition-all inline-block"
                            >Contáctanos</a
                        >
                    </li>
                    <li>
                        <a
                            href="/about"
                            class="text-base-content/60 hover:text-primary hover:translate-x-1 transition-all inline-block"
                            >Sobre FECOLSOG</a
                        >
                    </li>
                    <li>
                        <a
                            href="/faq"
                            class="text-base-content/60 hover:text-primary hover:translate-x-1 transition-all inline-block"
                            >Preguntas Frecuentes</a
                        >
                    </li>
                    <li>
                        <a
                            href="/envios"
                            class="text-base-content/60 hover:text-primary hover:translate-x-1 transition-all inline-block"
                            >Política de Envíos</a
                        >
                    </li>
                    <li>
                        <a
                            href="/devoluciones"
                            class="text-base-content/60 hover:text-primary hover:translate-x-1 transition-all inline-block"
                            >Devoluciones</a
                        >
                    </li>
                </ul>
            </div>

            <!-- Newsletter -->
            <div>
                <h3 class="font-bold text-lg mb-6 text-base-content/90">
                    Mantente Actualizado
                </h3>
                <p class="text-base-content/70 mb-4 text-sm">
                    Recibe noticias sobre congresos, guías clínicas y ofertas exclusivas para afiliados.
                </p>
                <div class="form-control w-full">
                    <div class="relative">
                        <label for="footer-email" class="sr-only">Correo electrónico</label>
                        <input
                            type="email"
                            id="footer-email"
                            name="email"
                            placeholder="Tu correo electrónico"
                            autocomplete="email"
                            class="input input-bordered w-full pr-12 focus:outline-hidden focus:border-primary"
                        />
                        <button
                            class="absolute top-0 right-0 rounded-l-none btn btn-primary px-3"
                            aria-label="Suscribirse"
                        >
                            <Icon name="lucide:arrow-right" class="w-5 h-5" />
                        </button>
                    </div>
                </div>
                <p class="text-base-content/40 text-xs mt-3">
                    Al suscribirte aceptas nuestra política de privacidad.
                </p>
            </div>
        </div>

        <div
            class="border-t border-base-content/10 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-base-content/50"
        >
            <p>
                &copy; {new Date().getFullYear()} FECOLSOG — Federación Colombiana de Obstetricia y Ginecología. Todos los derechos reservados.
            </p>
            <div class="flex gap-6">
                <a href="#" class="hover:text-base-content transition-colors"
                    >Política de Privacidad</a
                >
                <a href="#" class="hover:text-base-content transition-colors"
                    >Términos y Condiciones</a
                >
            </div>
        </div>
    </div>
</footer>

<style>
    .gradient-text {
        background: linear-gradient(
            135deg,
            var(--color-primary) 0%,
            #00897B 100%
        );
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
</style>
