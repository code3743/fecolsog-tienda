---

---

<form class="w-full">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Nombre -->
        <div class="flex flex-col">
            <label for="nombre" class="font-semibold text-[#0B2545] mb-2">
                Nombre
            </label>
            <input
                type="text"
                id="nombre"
                name="nombre"
                placeholder="Tu nombre"
                autocomplete="given-name"
                class="border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-primary"
                required
            />
        </div>

        <!-- Apellido -->
        <div class="flex flex-col">
            <label for="apellido" class="font-semibold text-[#0B2545] mb-2">
                Apellido
            </label>
            <input
                type="text"
                id="apellido"
                name="apellido"
                placeholder="Tu apellido"
                autocomplete="family-name"
                class="border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-primary"
                required
            />
        </div>

        <!-- Correo -->
        <div class="flex flex-col">
            <label for="correo" class="font-semibold text-[#0B2545] mb-2">
                Correo Electrónico
            </label>
            <input
                type="email"
                id="correo"
                name="correo"
                placeholder="correo@ejemplo.com"
                autocomplete="email"
                class="border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-primary"
                required
            />
        </div>

        <!-- Teléfono -->
        <div class="flex flex-col">
            <label for="telefono" class="font-semibold text-[#0B2545] mb-2">
                Teléfono
            </label>
            <input
                type="tel"
                id="telefono"
                name="telefono"
                placeholder="+57 300 000 0000"
                autocomplete="tel"
                class="border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-primary"
            />
        </div>
    </div>

    <!-- Mensaje -->
    <div class="flex flex-col mt-6">
        <label for="mensaje" class="font-semibold text-[#0B2545] mb-2">
            Mensaje
        </label>
        <textarea
            id="mensaje"
            name="mensaje"
            rows="5"
            placeholder="Escribe tu consulta aquí..."
            class="border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-primary resize-none"
            required></textarea>
    </div>

    <!-- Botón -->
    <div class="text-center md:text-right mt-8">
        <button
            type="submit"
            class="bg-primary text-primary-content hover:bg-primary/90 font-bold px-12 py-4 rounded-full cursor-pointer transition text-lg shadow-lg hover:shadow-xl hover:scale-105 transform duration-200"
        >
            Enviar Mensaje
        </button>
    </div>
</form>
