---
import { Icon } from "astro-icon/components";

interface Product {
    name: string;
    price: number;
    description: string;
    category: string;
    stock: number;
    badge?: string;
    discount?: number;
    image?: string;
    images?: string[];
    specs?: { label: string; value: string }[];
    sizes?: string[];
}

interface Props {
    product: Product;
}

const { product } = Astro.props;

const discountedPrice = product.price * (1 - (product.discount || 0) / 100);
---

<div
    class="product-info space-y-10"
    data-product={JSON.stringify({
        id: product.name.toLowerCase().replace(/\s+/g, "-"),
        name: product.name,
        price: product.price,
        image: product.image || (product as any).images?.[0] || "",
        category: product.category,
        discount: product.discount,
        stock: product.stock,
    })}
    data-sizes={JSON.stringify(product.sizes ?? [])}
>
    <!-- Header Info -->
    <div class="space-y-4">
        <span
            class="text-primary font-black uppercase text-xs tracking-[0.3em] italic"
        >
            {product.category}
            {product.badge ? `/ ${product.badge}` : ""}
        </span>
        <h1
            class="text-4xl md:text-5xl font-black text-slate-950 uppercase tracking-tighter leading-tight"
        >
            {product.name}
        </h1>
        <div class="flex items-center gap-4">
            <div class="flex flex-col">
                {
                    product.discount && product.discount > 0 && (
                        <span class="text-sm font-bold text-slate-400 line-through decoration-red-500/50">
                            ${product.price.toLocaleString("es-CO")} COP
                        </span>
                    )
                }
                <span class="text-4xl font-black text-slate-900">
                    ${
                        discountedPrice.toLocaleString("es-CO", {
                            minimumFractionDigits: 0,
                            maximumFractionDigits: 0,
                        })
                    } COP
                </span>
            </div>
            <div class="flex flex-col gap-2">
                {
                    product.discount && product.discount > 0 && (
                        <span class="badge bg-red-50 text-red-600 border-none font-black px-3 py-1 text-[10px] uppercase tracking-widest">
                            ¡Ahorra {product.discount}%!
                        </span>
                    )
                }
                {
                    product.stock > 0 ? (
                        <span class="badge bg-emerald-50 text-emerald-600 border-none font-bold p-3">
                            Disponible ({product.stock})
                        </span>
                    ) : (
                        <span class="badge bg-red-50 text-red-600 border-none font-bold p-3">
                            Agotado
                        </span>
                    )
                }
            </div>
        </div>
    </div>

    <!-- Description -->
    <div class="space-y-4">
        <h3
            class="text-[10px] font-black uppercase tracking-[0.3em] text-slate-600"
        >
            Descripción
        </h3>
        <p class="text-slate-600 font-medium leading-relaxed text-lg">
            {
                product.description ||
                    "Sin descripción disponible para este producto."
            }
        </p>
    </div>

    <!-- Specs Grid (se omite la fila "Tallas" cuando hay selector interactivo) -->
    {
        product.specs && (
            <div class="grid grid-cols-2 gap-6 p-8 bg-slate-50 rounded-3xl border border-slate-100">
                {product.specs
                    .filter((spec) => !(product.sizes?.length && spec.label === "Tallas"))
                    .map((spec) => (
                        <div class="space-y-1">
                            <p class="text-[10px] font-black uppercase tracking-widest text-slate-600">
                                {spec.label}
                            </p>
                            <p class="text-sm font-bold text-slate-900 uppercase italic">
                                {spec.value}
                            </p>
                        </div>
                    ))}
            </div>
        )
    }

    <!-- Size Selector -->
    {
        product.sizes && product.sizes.length > 0 && (
            <div class="space-y-3">
                <h3 class="text-[10px] font-black uppercase tracking-[0.3em] text-slate-600">
                    Talla
                </h3>
                <div
                    id="size-selector"
                    class="flex flex-wrap gap-2"
                    role="group"
                    aria-label="Seleccionar talla"
                >
                    {product.sizes.map((size) => (
                        <button
                            type="button"
                            class="size-btn w-12 h-12 rounded-xl border-2 font-black text-sm uppercase transition-all cursor-pointer"
                            data-size={size}
                            aria-pressed="false"
                        >
                            {size}
                        </button>
                    ))}
                </div>
                <p id="size-error" class="hidden text-xs font-bold text-red-500">
                    Seleccione una talla antes de agregar al carrito
                </p>
            </div>
        )
    }

    <!-- Purchase Actions -->
    <div class="space-y-6 pt-4">
        <div class="grid grid-cols-1 sm:grid-cols-[auto_1fr] gap-4">
            <!-- Quantity Selector -->
            <div
                class="flex items-center bg-slate-900 border-2 border-slate-100 rounded-2xl p-1 shadow-sm w-fit sm:w-auto"
            >
                <button
                    id="decrement-qty"
                    aria-label="Disminuir cantidad"
                    class="flex items-center justify-center p-4 hover:bg-slate-800 cursor-pointer rounded-xl transition-colors text-white disabled:opacity-30"
                >
                    <Icon name="lucide:minus" class="w-4.5 h-4.5" />
                </button>

                <span
                    id="quantity-display"
                    class="w-12 text-center text-white font-black text-xl"
                    >1</span
                >

                <button
                    id="increment-qty"
                    aria-label="Aumentar cantidad"
                    class="flex items-center justify-center p-4 hover:bg-slate-800 cursor-pointer rounded-xl transition-colors text-white disabled:opacity-30"
                >
                    <Icon name="lucide:plus" class="w-4.5 h-4.5" />
                </button>
            </div>

            <!-- Add to Cart -->
            <button
                id="add-to-cart-btn"
                class="w-full bg-primary text-white rounded-2xl py-5 px-8 font-black uppercase tracking-widest text-sm flex items-center justify-center gap-4 hover:bg-primary/80 transition-all active:scale-[0.98] cursor-pointer disabled:cursor-not-allowed disabled:opacity-50"
                disabled={product.stock <= 0}
            >
                <Icon name="lucide:shopping-bag" class="w-5 h-5" />
                Agregar al Carrito
            </button>

            <!-- Buy Now -->
            <button
                id="buy-now-btn"
                class="sm:col-span-2 w-full bg-primary text-white rounded-2xl py-5 font-black uppercase tracking-widest text-sm flex items-center justify-center gap-4 hover:bg-primary/80 transition-all active:scale-[0.98] cursor-pointer disabled:cursor-not-allowed disabled:opacity-50"
                disabled={product.stock <= 0}
            >
                <Icon name="lucide:credit-card" class="w-5 h-5" />
                Comprar Ahora
            </button>
        </div>
    </div>

    <!-- Trust Badges -->
    <div
        class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-4 border-t border-slate-100"
    >
        <div class="flex items-center gap-3 text-slate-700">
            <Icon name="lucide:shield-check" class="w-5 h-5 text-emerald-500" />
            <span class="text-[10px] uppercase font-bold tracking-widest"
                >Producto Certificado</span
            >
        </div>
        <div class="flex items-center gap-3 text-slate-700">
            <Icon name="lucide:truck" class="w-5 h-5 text-amber-500" />
            <span class="text-[10px] uppercase font-bold tracking-widest"
                >Envío a todo Colombia</span
            >
        </div>
    </div>
</div>

<script>
    import { addToCart } from "../../store/cartStore";
    import { toast } from "sonner";

    function setupPurchaseActions() {
        const productInfo = document.querySelector(".product-info");
        if (!productInfo) return;

        const product = JSON.parse(
            productInfo.getAttribute("data-product") || "{}",
        );
        const sizes: string[] = JSON.parse(
            productInfo.getAttribute("data-sizes") || "[]",
        );

        const decrementBtn = document.getElementById("decrement-qty");
        const incrementBtn = document.getElementById("increment-qty");
        const quantityDisplay = document.getElementById("quantity-display");
        const addToCartBtn = document.getElementById("add-to-cart-btn");
        const buyNowBtn = document.getElementById("buy-now-btn");
        const sizeError = document.getElementById("size-error");
        const sizeBtns = document.querySelectorAll<HTMLButtonElement>(".size-btn");

        let quantity = 1;
        let selectedSize: string | null = sizes.length === 0 ? null : null;

        // Size button logic — visual state via aria-pressed (CSS handles styling)
        sizeBtns.forEach((btn) => {
            btn.addEventListener("click", () => {
                sizeBtns.forEach((b) => b.setAttribute("aria-pressed", "false"));
                btn.setAttribute("aria-pressed", "true");
                selectedSize = btn.dataset.size || null;
                sizeError?.classList.add("hidden");
            });
        });

        const buildCartProduct = () => ({
            ...product,
            ...(selectedSize ? { size: selectedSize } : {}),
        });

        const validateSize = () => {
            if (sizes.length > 0 && !selectedSize) {
                sizeError?.classList.remove("hidden");
                return false;
            }
            return true;
        };

        const updateUI = () => {
            if (quantityDisplay) quantityDisplay.textContent = String(quantity);
            if (decrementBtn)
                (decrementBtn as HTMLButtonElement).disabled = quantity <= 1;
            if (incrementBtn)
                (incrementBtn as HTMLButtonElement).disabled =
                    quantity >= product.stock;
        };

        decrementBtn?.addEventListener("click", () => {
            if (quantity > 1) {
                quantity--;
                updateUI();
            }
        });

        incrementBtn?.addEventListener("click", () => {
            if (quantity < product.stock) {
                quantity++;
                updateUI();
            }
        });

        addToCartBtn?.addEventListener("click", () => {
            if (!validateSize()) return;
            const result = addToCart(buildCartProduct(), quantity);
            if (result.success) {
                toast.success(result.message);
            } else {
                toast.error(result.message);
            }
        });

        buyNowBtn?.addEventListener("click", () => {
            if (!validateSize()) return;
            const result = addToCart(buildCartProduct(), quantity);
            if (result.success) {
                window.location.href = "/checkout";
            } else {
                toast.error(result.message);
            }
        });

        updateUI();
    }

    setupPurchaseActions();
    document.addEventListener("astro:page-load", setupPurchaseActions);
</script>

<style>
    .size-btn {
        border-color: #e2e8f0; /* slate-200 */
        color: #475569;        /* slate-600 */
        background-color: transparent;
    }
    .size-btn:hover {
        border-color: var(--color-primary);
        color: var(--color-primary);
    }
    .size-btn[aria-pressed="true"] {
        border-color: var(--color-primary);
        color: var(--color-primary);
        background-color: color-mix(in oklch, var(--color-primary) 8%, transparent);
        font-weight: 900;
    }
</style>
