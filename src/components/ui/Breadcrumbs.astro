---
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items?: BreadcrumbItem[];
}

const { items = [] }: Props = Astro.props;
---

<nav aria-label="Ruta de navegación" class="breadcrumbs textarea-lg font-bold mb-8">
  <ol
    vocab="https://schema.org/"
    typeof="BreadcrumbList"
    class="flex flex-wrap items-center gap-1 list-none p-0 m-0"
  >
    {
      items.map((item, index) => (
        <li
          class="flex items-center gap-1"
          property="itemListElement"
          typeof="ListItem"
        >
          {index > 0 && (
            <span class="text-gray-400 mx-1 select-none" aria-hidden="true">/</span>
          )}
          {index < items.length - 1 && item.href ? (
            <a
              href={item.href}
              class="text-slate-700 hover:text-primary transition-colors"
              property="item"
              typeof="WebPage"
            >
              <span property="name">{item.label}</span>
            </a>
          ) : (
            <span
              class="text-primary font-bold"
              property="name"
              aria-current="page"
            >
              {item.label}
            </span>
          )}
          <meta property="position" content={String(index + 1)} />
        </li>
      ))
    }
  </ol>
</nav>
